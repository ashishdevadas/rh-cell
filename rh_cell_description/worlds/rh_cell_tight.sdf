<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rh_cell">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <!-- Ground and light: inline, so the world loads offline -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Wall at x = 0.60 m, 20 mm thick, TIGHT port: 74 x 74 mm opening (2 mm clearance per side for the
         70 mm cassette) with a 5 mm x 45 deg lead-in chamfer on the robot side (orange), so the opening is
         84 mm at the front face. Generated by scripts/gen_tight_world.py: front layer 5 mm with an 84 mm opening,
         back layer 15 mm with a 74 mm opening, 4 boxes rotated 45 deg forming the chamfer faces. -->
    <model name="wall_front_ymin"><static>true</static><pose>0.59250 -0.42100 0.35000 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0050 0.2580 0.5000</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0050 0.2580 0.5000</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_front_ymax"><static>true</static><pose>0.59250 -0.07900 0.35000 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0050 0.2580 0.5000</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0050 0.2580 0.5000</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_front_zmin"><static>true</static><pose>0.59250 -0.25000 0.20400 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0050 0.0840 0.2080</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0050 0.0840 0.2080</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_front_zmax"><static>true</static><pose>0.59250 -0.25000 0.49600 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0050 0.0840 0.2080</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0050 0.0840 0.2080</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_back_ymin"><static>true</static><pose>0.60250 -0.41850 0.35000 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0150 0.2630 0.5000</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0150 0.2630 0.5000</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_back_ymax"><static>true</static><pose>0.60250 -0.08150 0.35000 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0150 0.2630 0.5000</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0150 0.2630 0.5000</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_back_zmin"><static>true</static><pose>0.60250 -0.25000 0.20650 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0150 0.0740 0.2130</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0150 0.0740 0.2130</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="wall_back_zmax"><static>true</static><pose>0.60250 -0.25000 0.49350 0.000000 0.000000 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0150 0.0740 0.2130</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0150 0.0740 0.2130</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link></model>
    <model name="chamfer_yp"><static>true</static><pose>0.59500 -0.20800 0.35000 0.000000 0.000000 0.785398</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0071 0.0071 0.0840</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0071 0.0071 0.0840</size></box></geometry><material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.75 0.55 0.2 1</diffuse></material></visual></link></model>
    <model name="chamfer_zp"><static>true</static><pose>0.59500 -0.25000 0.39200 0.000000 0.785398 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0071 0.0840 0.0071</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0071 0.0840 0.0071</size></box></geometry><material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.75 0.55 0.2 1</diffuse></material></visual></link></model>
    <model name="chamfer_ym"><static>true</static><pose>0.59500 -0.29200 0.35000 0.000000 0.000000 0.785398</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0071 0.0071 0.0840</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0071 0.0071 0.0840</size></box></geometry><material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.75 0.55 0.2 1</diffuse></material></visual></link></model>
    <model name="chamfer_zm"><static>true</static><pose>0.59500 -0.25000 0.30800 0.000000 0.785398 0.000000</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.0071 0.0840 0.0071</size></box></geometry></collision><visual name="v"><geometry><box><size>0.0071 0.0840 0.0071</size></box></geometry><material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.75 0.55 0.2 1</diffuse></material></visual></link></model>

    <!-- Seat (backstop) behind the port. Front face at x = 0.71 m: where the cassette front face is
         when its rear face is flush with the wall. The force controller seats the cassette against it.
         The plate is spring-loaded (prismatic joint, 5 kN/m, 15 mm travel), like a compliant docking
         stop: a perfectly rigid stop gives force spikes of hundreds of newtons at first touch, faster
         than a 250 Hz force loop can react. -->
    <model name="seat">
      <pose>0 0 0 0 0 0</pose>
      <link name="base">
        <pose>0.75 -0.25 0.35 0 0 0</pose>
        <inertial><mass>5.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.02 0.15 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <link name="plate">
        <pose>0.72 -0.25 0.35 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.02 0.15 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.2 0.5 0.3 1</diffuse></material></visual>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>base</child></joint>
      <joint name="spring" type="prismatic">
        <parent>base</parent><child>plate</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>0</lower><upper>0.015</upper></limit>
          <dynamics><spring_reference>0</spring_reference><spring_stiffness>5000</spring_stiffness><damping>50</damping></dynamics>
        </axis>
      </joint>
    </model>

    <!-- Pedestal under the cassette's start position -->
    <model name="pedestal"><static>true</static><pose>0.45 0.25 0.155 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 0.10 0.31</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 0.10 0.31</size></box></geometry>
          <material><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link></model>
  </world>
</sdf>
